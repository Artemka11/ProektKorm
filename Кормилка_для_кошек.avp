 "java": "package com.pallascat.app;\n\nimport android.os.Bundle;\nimport android.widget.Button;\nimport android.widget.Toast;\nimport androidx.appcompat.app.AppCompatActivity;\n\npublic class MainActivity extends AppCompatActivity {\n\n    @Override\n    protected void onCreate(Bundle savedInstanceState) {\n        super.onCreate(savedInstanceState);\n        showMain();\n    }\n\n    private void showMain() {\n        setContentView(R.layout.activity_main);\n\n        Button btnDetails = findViewById(R.id.btnDetails);\n        Button btnScheme = findViewById(R.id.btnScheme);\n        Button btnComponents = findViewById(R.id.btnComponents);\n        Button btnHowItWorks = findViewById(R.id.btnHowItWorks);\n\n        btnDetails.setOnClickListener(v -> show(\"Подробнее о проекте\"));\n        btnScheme.setOnClickListener(v -> showScheme());\n        btnComponents.setOnClickListener(v -> show(\"Список компонентов\"));\n        btnHowItWorks.setOnClickListener(v -> show(\"Как работает кормилка\"));\n    }\n\n    private void showScheme() {\n        setContentView(R.layout.activity_scheme);\n\n        Button btnElectric = findViewById(R.id.btnElectric);\n        Button btnSchematic = findViewById(R.id.btnSchematic);\n        Button btnBack = findViewById(R.id.btnBackScheme);\n\n        btnElectric.setOnClickListener(v -> showElectric());\n        btnSchematic.setOnClickListener(v -> showSchematic());\n        btnBack.setOnClickListener(v -> showMain());\n    }\n\n    private void showElectric() {\n        setContentView(R.layout.activity_electric_scheme);\n\n        Button btnBack = findViewById(R.id.btnBackElectric);\n        btnBack.setOnClickListener(v -> showScheme());\n    }\n\n    private void showSchematic() {\n        setContentView(R.layout.activity_schematic_scheme);\n\n        Button btnBack = findViewById(R.id.btnBackSchematic);\n        btnBack.setOnClickListener(v -> showScheme());\n    }\n\n    private void show(String msg) {\n        Toast.makeText(this, msg, Toast.LENGTH_SHORT).show();\n    }\n}",
 "manifest": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<manifest xmlns:android=\"http://schemas.android.com/apk/res/android\"\n    package=\"com.pallascat.app\">\n\n    <application\n        android:allowBackup=\"true\"\n        android:label=\"@string/app_name\"\n        android:theme=\"@style/Theme.AppCompat.Light.NoActionBar\">\n        <activity android:name=\".MainActivity\" android:exported=\"true\">\n            <intent-filter>\n                <action android:name=\"android.intent.action.MAIN\" />\n                <category android:name=\"android.intent.category.LAUNCHER\" />\n            </intent-filter>\n        </activity>\n    </application>\n</manifest>",
 "strings": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<resources>\n    <string name=\"app_name\">Кормилка для кошек</string>\n    <string name=\"title\">Автоматическая кормилка для кошек</string>\n    <string name=\"btn_details\">Подробнее</string>\n    <string name=\"btn_scheme\">Схема</string>\n    <string name=\"btn_components\">Компоненты</string>\n    <string name=\"btn_how\">Как работает</string>\n    <string name=\"btn_electric\">Электрическая</string>\n    <string name=\"btn_schematic\">Принципиальная</string>\n    <string name=\"btn_back\">Назад</string>\n</resources>",
