  "activity_electric_scheme.xml": {
   "xml": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<AbsoluteLayout xmlns:android=\"http://schemas.android.com/apk/res/android\"\n    android:id=\"@+id/electricLayout\"\n    android:layout_width=\"match_parent\"\n    android:layout_height=\"match_parent\"\n    android:background=\"#F5F9FF\">\n\n    <TextView\n        android:id=\"@+id/tvElectricTitle\"\n        android:gravity=\"center\"\n        android:text=\"Электрическая схема\"\n        android:textSize=\"20sp\"\n        android:textColor=\"#1A237E\"\n        android:textStyle=\"bold\"\n        android:layout_x=\"20dp\"\n        android:layout_y=\"20dp\"\n        android:layout_width=\"280dp\"\n        android:layout_height=\"60dp\" />\n\n    <ImageView\n        android:id=\"@+id/imgElectric\"\n        android:src=\"@drawable/android_question\"\n        android:scaleType=\"fitCenter\"\n        android:layout_x=\"20dp\"\n        android:layout_y=\"85dp\"\n        android:layout_width=\"280dp\"\n        android:layout_height=\"170dp\" />\n\n    <TextView\n        android:id=\"@+id/tvElectricText\"\n        android:gravity=\"left|top\"\n        android:text=\"Питание: 5 В, 2 А на Arduino Nano (VIN, GND)\\nСервопривод SG90: +5 В, GND, сигнал — D9\\nRTC DS3231: VCC, GND, SDA — A4, SCL — A5\\nКнопка ручной подачи: D2 на GND\"\n        android:textSize=\"13sp\"\n        android:textColor=\"#212121\"\n        android:layout_x=\"20dp\"\n        android:layout_y=\"265dp\"\n        android:layout_width=\"280dp\"\n        android:layout_height=\"120dp\" />\n\n    <Button\n        android:id=\"@+id/btnBackElectric\"\n        android:gravity=\"center\"\n        android:text=\"Назад\"\n        android:textSize=\"15sp\"\n        android:textColor=\"#FFFFFF\"\n        android:backgroundTint=\"#90A4AE\"\n        android:layout_x=\"20dp\"\n        android:layout_y=\"400dp\"\n        android:layout_width=\"280dp\"\n        android:layout_height=\"50dp\" />\n\n</AbsoluteLayout>",
