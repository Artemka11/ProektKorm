  "activity_scheme.xml": {
   "xml": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<AbsoluteLayout xmlns:android=\"http://schemas.android.com/apk/res/android\"\n    android:id=\"@+id/schemeLayout\"\n    android:layout_width=\"match_parent\"\n    android:layout_height=\"match_parent\"\n    android:background=\"#F5F9FF\">\n\n    <TextView\n        android:id=\"@+id/tvSchemeTitle\"\n        android:gravity=\"center\"\n        android:text=\"Схема\"\n        android:textSize=\"22sp\"\n        android:textColor=\"#1A237E\"\n        android:textStyle=\"bold\"\n        android:layout_x=\"20dp\"\n        android:layout_y=\"25dp\"\n        android:layout_width=\"280dp\"\n        android:layout_height=\"70dp\" />\n\n    <TextView\n        android:id=\"@+id/tvSchemeHint\"\n        android:gravity=\"center\"\n        android:text=\"Выберите вид схемы\"\n        android:textSize=\"15sp\"\n        android:textColor=\"#546E7A\"\n        android:layout_x=\"20dp\"\n        android:layout_y=\"95dp\"\n        android:layout_width=\"280dp\"\n        android:layout_height=\"35dp\" />\n\n    <Button\n        android:id=\"@+id/btnElectric\"\n        android:gravity=\"center\"\n        android:text=\"Электрическая\"\n        android:textSize=\"16sp\"\n        android:textColor=\"#FFFFFF\"\n        android:backgroundTint=\"#0099FF\"\n        android:layout_x=\"20dp\"\n        android:layout_y=\"150dp\"\n        android:layout_width=\"280dp\"\n        android:layout_height=\"60dp\" />\n\n    <Button\n        android:id=\"@+id/btnSchematic\"\n        android:gravity=\"center\"\n        android:text=\"Принципиальная\"\n        android:textSize=\"16sp\"\n        android:textColor=\"#FFFFFF\"\n        android:backgroundTint=\"#0099FF\"\n        android:layout_x=\"20dp\"\n        android:layout_y=\"225dp\"\n        android:layout_width=\"280dp\"\n        android:layout_height=\"60dp\" />\n\n    <Button\n        android:id=\"@+id/btnBackScheme\"\n        android:gravity=\"center\"\n        android:text=\"Назад\"\n        and